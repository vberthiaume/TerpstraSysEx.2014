cmake_minimum_required(VERSION 3.27)

project(LUMATONE_EDITOR VERSION 0.0.1)

# find_package(juce)
add_subdirectory($ENV{juce_DIR} subprojects/juce)

juce_add_gui_app(
    LumatoneEditor
        PRODUCT_NAME "Lumatone Editor"
        VERSION "1.2.0b"
        BUNDLE_ID "com.Lumatone.LumatoneEditor"
        ICON_SMALL "${CMAKE_CURRENT_SOURCE_DIR}/Source/assets/PNG/AppIcon@1x.png"
        ICON_BIG "${CMAKE_CURRENT_SOURCE_DIR}/Source/assets/PNG/AppIcon@3x.png"
        DOCUMENT_EXTENSIONS "ltn"
        )
juce_generate_juce_header(LumatoneEditor)

set(CMAKE_OSX_DEPLOYMENT_TARGET 10.15)

set_directory_properties(
    PROPERTIES
        COMPANY_COPYRIGHT "BSD-0"
        COMPANY_NAME "Lumatone"
        COMPANY_WEBSITE "https://www.lumatone.io"
        COMPANY_EMAIL "support@lumatone.io"
)

file(GLOB_RECURSE SourceCode
    CONFIGURE_DEPENDS
        "${CMAKE_CURRENT_SOURCE_DIR}/Source/*.h"
        "${CMAKE_CURRENT_SOURCE_DIR}/Source/*.cpp"
    )


if (${CMAKE_SYSTEM_NAME} STREQUAL "Windows")
    set(LibraryPath     "${CMAKE_CURRENT_SOURCE_DIR}/Libraries/win64")
    set(LibraryInclude  "${LibraryPath}/include")
    set(SSHLib          "${LibraryPath}/lib/libssh2.lib")

elseif(APPLE)
    set_target_properties(LumatoneEditor PROPERTIES INSTALL_RPATH_USE_LINK_PATH TRUE)

    set(LibraryPath     "${CMAKE_CURRENT_SOURCE_DIR}/Libraries/mac")
    set(LibraryInclude  "${LibraryPath}/include")
    set(LibGpgError     "${LibraryPath}/lib/libgpg-error.a")
    set(LibGCrypt       "${LibraryPath}/lib/libgcrypt.a")
    set(SSHLib          "${LibraryPath}/lib/libssh2.a")

elseif(UNIX)
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(SSHLib REQUIRED libssh2)

    target_include_directories(LumatoneEditor PUBLIC ${SSHLib_INCLUDE_DIRS})
    target_compile_options(LumatoneEditor PUBLIC ${SSHLib_CFLAGS_OTHER})
endif()

include_directories(${LibraryInclude})

target_sources(
    LumatoneEditor
        PRIVATE
            ${SourceCode}
            )

target_compile_definitions(LumatoneEditor
    PRIVATE
        SERVERKEY="debian"
        SERVERPWD="temppwd"

        SERVERHOST1="192.168.6.2"
        SERVERHOST2="192.168.7.2"

        JUCE_WEB_BROWSER=0
        JUCE_USE_CURL=0
        JUCE_APPLICATION_NAME_STRING="$<TARGET_PROPERTY:LumatoneEditor,PRODUCT_NAME>"
        JUCE_APPLICATION_VERSION_STRING="$<TARGET_PROPERTY:LumatoneEditor,JUCE_VERSION>"
        DONT_SET_USING_JUCE_NAMESPACE=0
    )

if (UNIX)
    target_compile_definitions(LumatoneEditor
        PRIVATE
        HAVE_SYS_SOCKET_H=1
        HAVE_NETINET_IN_H=1
        HAVE_SYS_SELECT_H=1
        HAVE_UNISTD_H=1
        HAVE_ARPA_INET_H=1
        HAVE_SYS_TIME_H=1
        HAVE_POLL_H=1
    )
endif()

if (${CMAKE_SYSTEM_NAME} STREQUAL "Windows")
    target_compile_definitions(LumatoneEditor
        PRIVATE
        SERVERHOST="192.168.7.2"
    )
endif()

file(GLOB_RECURSE EditorBinaryData
        CONFIGURE_DEPENDS   
            "${CMAKE_CURRENT_SOURCE_DIR}/Source/assets/*"
            "${CMAKE_CURRENT_SOURCE_DIR}/Source/backport/assets/*"
    )
juce_add_binary_data(LumatoneEditorAssets SOURCES ${EditorBinaryData})

if (APPLE OR ${CMAKE_SYSTEM_NAME} STREQUAL "Windows")
    target_link_libraries(LumatoneEditor
        PRIVATE
            LumatoneEditorAssets
            juce::juce_audio_utils
            juce::juce_audio_devices
            juce::juce_opengl

            ${LibGpgError}
            ${LibGCrypt}
            ${SSHLib}

        PUBLIC
            juce::juce_recommended_config_flags
            juce::juce_recommended_lto_flags
            juce::juce_recommended_warning_flags
        )
else()
    target_link_libraries(LumatoneEditor
        PRIVATE
            LumatoneEditorAssets
            juce::juce_audio_utils
            juce::juce_audio_devices
            juce::juce_opengl

            ${SSHLib_LIBRARIES}

        PUBLIC
            juce::juce_recommended_config_flags
            juce::juce_recommended_lto_flags
            juce::juce_recommended_warning_flags
        )
endif()

if (APPLE)
   target_link_options(LumatoneEditor PUBLIC -Wl -ld_classic)
endif()

